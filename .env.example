# API base URL used for server-side rendering / server components.
# Browser requests go through Next.js rewrites (see next.config.ts), so this
# mainly matters for SSR. Point it at the deployed backend in production.
#   Local dev : http://localhost:8000/api/v1
#   Production: https://<workspace>--examind-be-api.modal.run/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Base URL of the FastAPI backend used by next.config.ts rewrites.
#   Local dev : http://localhost:8000
#   Production: https://<workspace>--examind-be-api.modal.run
BACKEND_URL=http://localhost:8000

# WhatsApp number for customer-service widget (optional)
NEXT_PUBLIC_CS_WHATSAPP=6281234567890
